.carrito-page {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 80vh;
  background-image: url("../assets/tienda.jpeg");
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  display: flex;

}
.cart-section {
  width: 95%;
}

.carrito-total {
  width: 20%;
  color: white;
  background-color: black;
}

.cart-section > h2 {
  margin: auto;
  text-align: center;
  color: white;
  width: 20%;
  background-color: black
}

.cart-products {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 80%;
  gap: 15px;
}

.cart-product {
  height: 15vh;
  display: flex;
  align-items: center;
  justify-content: space-evenly;
  border-bottom: 1px solid black;
  border-right: 1px solid black;
  background-color: black;
  color: white;
}

.cart-product img {
  width: 10%;
  height: 100%;
}


.cart-product-prices {
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.cart-product-total-price {
  margin: 0;
  padding: 0;
  font-size: 20px;
}

.cart-product-unit-price {
  margin: 0;
  padding: 0;
  font-size: 12px
}

.cart-product-quantity {
  padding: 0;
  margin: 0;
  font-size: 20px;
}

.cart-product-details {
  width: 75%;
}
.cart-product-title {
  font-size: 25px;
  font-weight: bold; 
}
.cart-product-remove {
  text-align: center;
  font-size: 15px;
  background-color: #bb3e81;
  border: 1px solid #bb3e81;
  color: white;
  margin-top: 5px;
  padding: 2px;
  width: 12%;
}
.cart-product-remove:hover {
  cursor: pointer;
  color: #b30060;
  background-color: white;
  border: 1px solid #bb3e81;
}

.cart-subtotal {
  width: 80%;
  display: flex;
  flex-direction: column;
  align-items: end;
}

.cart-total {
  font-size: 25px;
}

.cart-continue {
  font-size: 21px;
  text-align: center;
  background-color: #bb3e81;
  border: 1px solid #bb3e81;
  color: white;
  margin-top: 5px;
  padding: 2px;
  width: 12%;
}
.cart-continue:hover {
  cursor: pointer;
  color: #b30060;
  background-color: white;
  border: 1px solid #bb3e81;
}

.modal-address {
  position: fixed;
  width: 100vw;
  height: 100vh;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  width: 40%;
  height: 55%;
  background-color: #fff8f1;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: modal-animation 0.8s ease-out;
  z-index: 31;
}

.bg-modal {
  z-index: 30;
  position: absolute;
  width: 100%;
  height: 100%;
  background-color: rgba(0,0,0,0.7);
}

.cart-address-title {
  font-size: 50px;
  font-weight: 900;
  padding-bottom: 20px;
  margin-top: 15px;
}

.form-address {
  justify-self: center;
  display: grid;
  grid-template-columns: auto auto;
  grid-template-rows: 20% 20% 50% 10%;
  justify-items: center;
  gap: 20px;
  width: 80%;
}

.cart-input {
  width: 100%;
  font-size: 20px;
  display: flex;
  flex-direction: column;
}

.input-normal {
  width: 90%;
  align-self: center;
  padding: 7px;
  font-size: 15px;
}
.address-email {
  grid-column: 1 / span 2;
  width: 100%;
}

.input-email {
  width: 95%;
  align-self: center;
  padding: 7px;
  font-size: 15px;
}

.cart-address-send {
  width: 18%;
  font-size: 20px;
  text-align: center;
  justify-self: center;
  background-color: #b30060;
  color: white;
  padding: 3px;
  border-radius: 100px;
  border: 1px solid #b30060;
}

.cart-address-send:hover {
  background-color: white;
  color: #b30060;
  border: 1px solid #b30060;
  cursor: pointer;
}

@keyframes modal-animation {

  0%{
      transform: translateY(-600px);
  }
  100%{
      transform: translateY(0);
  }
  
}
